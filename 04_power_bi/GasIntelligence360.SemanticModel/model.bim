                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"operacao_id\", type text}, {\"sk_cidade\", Int64.Type}, {\"sk_tempo\", Int64.Type}, {\"volume_distribuido_m3\", type number}, {\"volume_medido_m3\", type number}, {\"perda_m3\", type number}, {\"custo_operacional_brl\", type number}}, \"en-US\")",
