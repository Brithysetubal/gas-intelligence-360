          },
          {
            "name": "status_pagamento",
            "dataType": "string",
            "sourceColumn": "status_pagamento",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fato_faturamento",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(Web.Contents(UrlBase & \"fato_faturamento.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"fatura_id\", type text}, {\"sk_contrato\", Int64.Type}, {\"sk_cliente\", Int64.Type}, {\"sk_cidade\", Int64.Type}, {\"sk_tempo\", Int64.Type}, {\"volume_m3\", type number}, {\"tipo_leitura\", type text}, {\"status_leitura\", type text}, {\"tarifa_brl_m3\", type number}, {\"valor_fatura_brl\", type number}, {\"status_fatura\", type text}, {\"data_vencimento\", type date}, {\"valor_pago_brl\", type number}, {\"data_pagamento\", type date}, {\"meio_pagamento\", type text}, {\"dias_atraso\", type number}, {\"status_pagamento\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
