                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"sk_cliente\", Int64.Type}, {\"cliente_id\", type text}, {\"nome_ficticio\", type text}, {\"sk_cidade\", Int64.Type}, {\"segmento\", type text}, {\"data_cadastro\", type date}, {\"status_cliente\", type text}, {\"segmento_inferido\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
