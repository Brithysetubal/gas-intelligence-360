            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "sk_tempo",
            "dataType": "int64",
            "sourceColumn": "sk_tempo",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "data_ocorrencia",
            "dataType": "dateTime",
            "sourceColumn": "data_ocorrencia",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "tipo_ocorrencia",
            "dataType": "string",
            "sourceColumn": "tipo_ocorrencia",
            "summarizeBy": "none"
          },
          {
            "name": "severidade",
            "dataType": "string",
            "sourceColumn": "severidade",
            "summarizeBy": "none"
          },
          {
            "name": "status_ocorrencia",
            "dataType": "string",
            "sourceColumn": "status_ocorrencia",
