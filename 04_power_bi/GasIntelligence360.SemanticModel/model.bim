          }
        ],
        "partitions": [
          {
            "name": "fato_ocorrencia",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(Web.Contents(UrlBase & \"fato_ocorrencia.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecalhos, {{\"ocorrencia_id\", type text}, {\"sk_contrato\", Int64.Type}, {\"sk_cliente\", Int64.Type}, {\"sk_cidade\", Int64.Type}, {\"sk_tempo\", Int64.Type}, {\"data_ocorrencia\", type date}, {\"tipo_ocorrencia\", type text}, {\"severidade\", type text}, {\"status_ocorrencia\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Coluna",
            "dataType": "string",
            "sourceColumn": "Coluna",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = #table(type table [Coluna = text], {})",
                "in",
                "    Fonte"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Faturado",
            "expression": [
              "SUM ( fato_faturamento[valor_fatura_brl] )"
            ],
            "formatString": "\\R$ #,0.00;-\\R$ #,0.00;\\R$ #,0.00"
          },
          {
            "name": "Recebido",
            "expression": [
              "SUM ( fato_faturamento[valor_pago_brl] )"
            ],
            "formatString": "\\R$ #,0.00;-\\R$ #,0.00;\\R$ #,0.00"
          },
          {
            "name": "Em Aberto",
            "expression": [
              "[Faturado] - [Recebido]"
            ],
            "formatString": "\\R$ #,0.00;-\\R$ #,0.00;\\R$ #,0.00"
          },
          {
            "name": "% Inadimplência",
            "expression": [
              "DIVIDE ( [Em Aberto], [Faturado] )"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Ticket Médio Mensal",
            "expression": [
              "DIVIDE ( [Faturado], COUNTROWS ( fato_faturamento ) )"
            ],
            "formatString": "\\R$ #,0.00;-\\R$ #,0.00;\\R$ #,0.00"
          },
          {
            "name": "Faturado Mês Anterior",
            "expression": [
              "VAR MesAtual = MAX ( dim_tempo[sk_tempo] )",
              "VAR MesAnterior = IF ( MOD ( MesAtual, 100 ) = 1, MesAtual - 89, MesAtual - 1 )",
              "RETURN",
              "    CALCULATE ( [Faturado], ALL ( dim_tempo ), dim_tempo[sk_tempo] = MesAnterior )"
            ],
            "formatString": "\\R$ #,0.00;-\\R$ #,0.00;\\R$ #,0.00"
          },
          {
            "name": "Var % MoM",
            "expression": [
              "DIVIDE ( [Faturado] - [Faturado Mês Anterior], [Faturado Mês Anterior] )"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Faturado YTD",
            "expression": [
              "VAR MesAtual = MAX ( dim_tempo[sk_tempo] )",
              "RETURN",
              "    CALCULATE (",
              "        [Faturado],",
              "        ALL ( dim_tempo ),",
              "        dim_tempo[ano] = INT ( MesAtual / 100 ),",
              "        dim_tempo[sk_tempo] <= MesAtual",
              "    )"
            ],
            "formatString": "\\R$ #,0.00;-\\R$ #,0.00;\\R$ #,0.00"
          },
          {
            "name": "% Receita do Total",
            "expression": [
              "DIVIDE ( [Faturado], CALCULATE ( [Faturado], ALL ( dim_cliente ) ) )"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Faturas",
            "expression": [
              "COUNTROWS ( fato_faturamento )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Atraso Médio (dias)",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( fato_faturamento, NOT ISBLANK ( fato_faturamento[dias_atraso] ) ),",
              "    fato_faturamento[dias_atraso]",
              ")"
            ],
            "formatString": "0.0"
          },
          {
            "name": "% Pago no Prazo",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Faturas], fato_faturamento[status_pagamento] = \"Pago no prazo\" ),",
              "    CALCULATE ( [Faturas], fato_faturamento[status_pagamento] <> \"Sem cobrança\" )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Pago com Atraso",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Faturas], fato_faturamento[status_pagamento] = \"Pago com atraso\" ),",
              "    CALCULATE ( [Faturas], fato_faturamento[status_pagamento] <> \"Sem cobrança\" )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Contratos Ativos",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( dim_contrato[contrato_id] ), dim_contrato[status_contrato] = \"Ativo\" )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Ranking Devedores",
            "expression": [
              "RANKX ( ALL ( dim_cliente[cliente_id] ), [Em Aberto], , DESC, DENSE )"
            ],
            "formatString": "0"
          },
          {
            "name": "Volume Faturado (m³)",
            "expression": [
              "SUM ( fato_faturamento[volume_m3] )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Volume Distribuído (m³)",
            "expression": [
              "SUM ( fato_operacao[volume_distribuido_m3] )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Volume Medido (m³)",
            "expression": [
              "SUM ( fato_operacao[volume_medido_m3] )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Perda Técnica",
            "expression": [
              "DIVIDE ( SUM ( fato_operacao[perda_m3] ), [Volume Distribuído (m³)] )"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Custo por m³",
            "expression": [
              "DIVIDE ( SUM ( fato_operacao[custo_operacional_brl] ), [Volume Medido (m³)] )"
            ],
            "formatString": "\\R$ #,0.00;-\\R$ #,0.00;\\R$ #,0.00"
          },
          {
            "name": "Ocorrências",
            "expression": [
              "COUNTROWS ( fato_ocorrencia )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Ocorrências Abertas",
            "expression": [
